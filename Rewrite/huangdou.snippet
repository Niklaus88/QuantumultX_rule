#!name=黄豆短剧/影视 去广告 & VIP 解锁
#!desc=黄豆短剧与影视全网VIP免费看、去除各类开屏/暂停/信息流广告、解锁全集播放与清晰度
# > 项目地址: https://github.com/Niklaus88/QuantumultX_rule

# 缓存播放请求上下文参数 (POST body)
^https?:\/\/.*\/api\/(drama\/play|up\/episodePreview) url script-request-body https://raw.githubusercontent.com/Niklaus88/QuantumultX_rule/main/Scripts/huangdou.js

# 解密响应数据、净化广告、解锁 VIP 并重加密回传
^https?:\/\/.*\/api\/(system\/info|ad\/policy|user\/(info|home|vip|favorite)|drama\/(play|doBuy|detail|navBlock|navFilter|searchResult|more|rank|topicDetail|topicList|favorite|love|wish)|movie\/(navBlock|detail|navFilter|favorite|love|history)|up\/(episodePreview|bannerList|episodeFeed|recommend|home|content|episodeList|detail)|search\/movie) url script-response-body https://raw.githubusercontent.com/Niklaus88/QuantumultX_rule/main/Scripts/huangdou.js

hostname = *.cocoaview.cc, cocoaview.cc

