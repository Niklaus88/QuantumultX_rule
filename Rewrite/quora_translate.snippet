#!name=Quora 自动翻译与体验净化
#!desc=自动将 Quora 网页及添加到主屏幕的 PWA 翻译为简体中文，实时拦截“下载App”弹窗遮罩，去除免登录限制与内容模糊
# > 项目地址: https://github.com/Niklaus88/QuantumultX_rule

# 1. 请求头重写：仅对 GET 网页移除 br 压缩，强制返回 gzip，跳过所有 API 与登录接口
^https?:\/\/(www\.)?quora\.com\/(?!graphql|api\/|_/).* url script-request-header https://raw.githubusercontent.com/Niklaus88/QuantumultX_rule/main/Scripts/quora_translate.js

# 2. 响应头重写：放行 HTML 页面 CSP，严格避开 API 与登录鉴权 Cookie
^https?:\/\/(www\.)?quora\.com\/(?!graphql|api\/|_/).* url script-response-header https://raw.githubusercontent.com/Niklaus88/QuantumultX_rule/main/Scripts/quora_translate.js

# 3. 响应体重写：仅针对 HTML 页面注入翻译引擎与净化补丁，保护登录表单不崩
^https?:\/\/(www\.)?quora\.com\/(?!graphql|api\/|_/).* url script-response-body https://raw.githubusercontent.com/Niklaus88/QuantumultX_rule/main/Scripts/quora_translate.js

hostname = *.quora.com, quora.com
