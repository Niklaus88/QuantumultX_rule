#!name=Spotify 完整净化与体验增强
#!desc=去除音频与视觉广告、解锁自由点歌与无限切歌、修复8-10秒暂停跳转与闪退异常、解锁全曲库畅听
# > 项目地址: https://github.com/Niklaus88/QuantumultX_rule

# 1. 拦截会员推广与营销弹窗 (放行 gabo 播放心跳上报，避免 8-10 秒播放中断)
^https?:\/\/(.*\.wg|.*-spclient)\.spotify\.com(:443)?\/(pendragon|pam-view-service\/) url reject-200

# 2. 移除 ETag 缓存头，强制服务端返回 200 响应以保证重写生效
^https:\/\/(.*\.wg|.*-spclient)\.spotify\.com(:443)?\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ url script-request-header https://raw.githubusercontent.com/Niklaus88/QuantumultX_rule/main/Scripts/spotify-header.js

# 3. 动态伪装 iPad 平台标识，解锁已点赞歌曲(Collection)、歌单、专辑、艺人页面的自由选曲与快进特权
^https:\/\/(.*\.wg|.*-spclient)\.spotify\.com(:443)?\/(.*platform=iphone|artistview\/|.*-entity-view\/|collection\/) url script-request-header https://raw.githubusercontent.com/Niklaus88/QuantumultX_rule/main/Scripts/spotify-platform.js

# 4. 重写 Protobuf 账户配置与远程实验配置 (基于 Eevee v3 架构，彻底消除 8-10 秒中断/跳歌/闪退与选歌限制)
^https:\/\/(.*\.wg|.*-spclient)\.spotify\.com(:443)?\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ url script-response-body https://raw.githubusercontent.com/Niklaus88/QuantumultX_rule/main/Scripts/spotify-proto.js

hostname = spclient.wg.spotify.com, *.wg.spotify.com, *spclient.spotify.com, gae2-spclient.wg.spotify.com

